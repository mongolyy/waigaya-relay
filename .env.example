# waigaya-relay の環境変数サンプル
#
# ローカル開発: このファイルを `.env.local` にコピーして実際の値を設定してください。
#   cp .env.example .env.local
# Vercel: ダッシュボードの Project → Settings → Environment Variables に同じ変数を登録してください。
#
# 注意: Webhook URL はシークレットです。絶対にコミットしないでください
#       （.env* は .gitignore 済み）。

# Slack Incoming Webhook の URL
# 形式: https://hooks.slack.com/services/<TEAM_ID>/<CHANNEL_ID>/<TOKEN>
SLACK_WEBHOOK_URL=

# Slack Webhook URL を設定・変更した日時（ISO 8601）
# サプライチェーン攻撃対策: 設定から 3 日間はリレーをスキップします。
# URL を初めて設定したとき、または変更したときに現在時刻を記録してください。
# 例: SLACK_WEBHOOK_REGISTERED_AT=2024-01-15T00:00:00Z
SLACK_WEBHOOK_REGISTERED_AT=

# Microsoft Teams Incoming Webhook の URL
# 例: https://outlook.office.com/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx@.../IncomingWebhook/.../...
TEAMS_WEBHOOK_URL=

# Teams Webhook URL を設定・変更した日時（ISO 8601）
# サプライチェーン攻撃対策: 設定から 3 日間はリレーをスキップします。
# 例: TEAMS_WEBHOOK_REGISTERED_AT=2024-01-15T00:00:00Z
TEAMS_WEBHOOK_REGISTERED_AT=
