# waigaya-relay environment variable template
#
# Local development: copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# Vercel: add the same variables under Project → Settings → Environment Variables.
#
# Note: bot tokens and webhook URLs are secrets — never commit them.
#       (.env* is already listed in .gitignore)

# --- Slack (Web API / chat.postMessage) ---
# A bot token is required for per-session thread replies.
# Create a Slack app, grant the `chat:write` scope, and invite it to the channel.
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=
# Target channel ID (e.g. C0123456789)
SLACK_CHANNEL_ID=

# --- Microsoft Teams (Incoming Webhook) ---
# e.g. https://outlook.office.com/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx@.../IncomingWebhook/.../...
TEAMS_WEBHOOK_URL=

# --- Session → thread store (Upstash Redis, optional) ---
# Stores the session-to-thread mapping. Falls back to an in-memory Map when unset
# (single-instance only — configure this for Vercel or other multi-instance deployments).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
