# waigaya-relay の環境変数サンプル
#
# ローカル開発: このファイルを `.env.local` にコピーして実際の値を設定してください。
#   cp .env.example .env.local
# Vercel: ダッシュボードの Project → Settings → Environment Variables に同じ変数を登録してください。
#
# 注意: Bot トークンや Webhook URL はシークレットです。絶対にコミットしないでください
#       （.env* は .gitignore 済み）。

# --- Slack (Web API / chat.postMessage) ---
# セッションごとのスレッド投稿には Bot トークン方式が必要です。
# Slack アプリを作成し、`chat:write` スコープを付与してチャンネルに招待してください。
# Bot User OAuth Token（xoxb- で始まる）
SLACK_BOT_TOKEN=
# 投稿先チャンネルの ID（例: C0123456789）
SLACK_CHANNEL_ID=

# --- Microsoft Teams (Incoming Webhook) ---
# 例: https://outlook.office.com/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx@.../IncomingWebhook/.../...
TEAMS_WEBHOOK_URL=

# --- Session → thread store (Upstash Redis, optional) ---
# セッションとスレッドの対応表の保存先。未設定の場合はインメモリにフォールバックします
# （単一インスタンス向け。Vercel 等の本番ではスレッドが途切れる可能性があるため設定推奨）。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
