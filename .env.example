# waigaya-relay environment variable template
#
# Local development: copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# Vercel: add the same variables under Project → Settings → Environment Variables.
#
# Note: bot tokens and secrets are secrets — never commit them.
#       (.env* is already listed in .gitignore)

# --- Slack (Web API / chat.postMessage) ---
# A bot token is required for per-session thread replies.
# Create a Slack app, grant the `chat:write` scope, and invite it to the channel.
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=
# Target channel ID (e.g. C0123456789)
SLACK_CHANNEL_ID=

# --- Microsoft Teams ---
# Two modes are supported. Bot Framework is preferred (enables session threading).
# If both are set, Bot Framework takes precedence.
#
# Mode A: Incoming Webhook (simple setup, no threading)
# Create an Incoming Webhook connector in your Teams channel and paste the URL here.
TEAMS_WEBHOOK_URL=
#
# Mode B: Bot Framework (enables per-session thread replies)
# Requires an Azure Bot resource and a Teams app installed in the target team.
# Setup steps:
#   1. Register an Azure Bot (or App Registration + Bot Service) in Azure Portal.
#   2. Note the App (client) ID and create a client secret.
#   3. Create a Teams app package (manifest.json + icons) declaring the bot with
#      scopes: ["team"], and install it into the target team.
#   4. Copy the target channel ID from the Teams client (starts with 19:).
#
# Azure AD Application (client) ID for the Bot
TEAMS_BOT_APP_ID=
# Client secret for the above Azure AD app
TEAMS_BOT_APP_PASSWORD=
# Azure AD tenant ID where the app is registered
TEAMS_BOT_TENANT_ID=
# Teams channel ID to post into (e.g. 19:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@thread.tacv2)
TEAMS_CHANNEL_ID=

# --- Upstash Redis (required for multi-user shared messages and session threading) ---
# Add Upstash Redis via Vercel Marketplace: https://vercel.com/marketplace?category=storage&search=redis
# Falls back to an in-memory Map when unset (single-instance only — messages are not shared across users).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
